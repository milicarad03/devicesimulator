{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Smart Light Device Model",
  "description": "Schema for validating smart light device telemetry model.",
  "type": "object",
  "required": ["meta", "sendInterval", "state", "events"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["serial", "deviceType", "location"],
      "properties": {
        "serial": {
          "type": "string",
          "minLength": 1,
          "examples": ["light-200"]
        },
        "deviceType": {
          "type": "string",
          "const": "SMART_LIGHT"
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "examples": ["living-room"]
        }
      },
      "additionalProperties": false
    },
    "sendInterval": {
      "type": "integer",
      "minimum": 1000,
      "examples": [3000]
    },
    "state": {
      "$ref": "#/$defs/lightState"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lightState"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "lightState": {
      "type": "object",
      "required": ["power", "brightness", "color", "mode"],
      "properties": {
        "power": {
          "type": "boolean"
        },
        "brightness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "color": {
          "type": "object",
          "required": ["r", "g", "b"],
          "properties": {
            "r": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "g": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "b": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "additionalProperties": false
        },
        "mode": {
          "type": "string",
          "enum": ["WARM", "COLD", "RGB", "NIGHT", "AUTO", "OFF"]
        }
      },
      "additionalProperties": false
    }
  }
}