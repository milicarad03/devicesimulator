{
  "type": "object",
  "title": "SmartPumpTelemetry",
  "required": [
    "schemaId"
  ],
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "modelC",
      "x-reporting": {
        "IDLE": 120000,
        "ACTIVE": 5000
      }
    },
    "attributes": {
     "type": "object",
      "required": [
        "serialNumber",
        "firmware",
        "hardwareModel"
      ],
      "properties": {
        "serialNumber": {
          "type": "string"
        },
        "firmware": {
          "type": "string"
        },
        "hardwareModel": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "system": {
      "type": "object",
 
      "properties": {
        "identity": {
          "type": "object",
          "properties": {
            "serial": {
              "type": "string",
              "pattern": "^SP-[0-9]{5}-X$",
              "x-reporting": {
                "IDLE": 120000,
                "ACTIVE": 5000
              }
            },
            "firmware": {
              "type": "string",
              "x-reporting": {
                "IDLE": 120000,
                "ACTIVE": 5000
              }
            }
          }
        },
        "status": {
          "type": "object",
          "properties": {
            "pumpEnabled": {
              "type": "boolean",
              "x-reporting": {
                "IDLE": 120000,
                "ACTIVE": 5000
              }
            },
            "targetFlow": {
              "type": "number",
              "minimum": 0,
              "maximum": 500,
              "x-reporting": {
                "IDLE": 120000,
                "ACTIVE": 5000
              }
            },
            "alarm": {
              "type": "boolean",
              "x-reporting": {
                "IDLE": 120000,
                "ACTIVE": 5000
              }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "flowRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 500,
          "x-reporting": {
            "IDLE": null,
            "ACTIVE": 5000
          }
        },
        "inletPressure": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "x-reporting": {
            "IDLE": null,
            "ACTIVE": 5000
          }
        },
        "outletPressure": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "x-reporting": {
            "IDLE": null,
            "ACTIVE": 5000
          }
        },
        "energyUsage": {
          "type": "number",
          "minimum": 0,
          "x-reporting": {
            "IDLE": null,
            "ACTIVE": 5000
          }
        },
        "motorTemperature": {
        "type": "number",
        "minimum": 0,
        "maximum": 120,
        "x-reporting": {
            "IDLE": null,
            "ACTIVE": 5000
        }
        }
      }
    },
    "historicalTelemetry": {
      "type": "object",
      "properties": {
        "flowRate": {
          "type": "array",
          "items": {
            "type": "array",
            "items": false,
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 500
              },
              {
                "type": "string"
              }
            ]
          },
          "maxItems": 24,
          "x-buffering": {
            "interval": 10000
          }
        },
        "energyUsage": {
          "type": "array",
          "items": {
            "type": "array",
            "items": false,
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string"
              }
            ]
          },
          "maxItems": 24,
          "x-buffering": {
            "interval": 15000
          }
        }
      },
      "x-reporting": {
        "IDLE": 120000,
        "ACTIVE": null
      },
      "additionalProperties": false
    }
  },
  "commands": {
    "SET_STATE": {
      "payload": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "IDLE"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "SET_PUMP_STATE": {
      "x-idempotency": {
        "stateBinding": "pumpEnabled",
        "payloadPath": "enabled",
        "maxAgeMs": 15000
      },
      "payload": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "SET_FLOW_TARGET": {
      "x-idempotency": {
        "stateBinding": "targetFlow",
        "payloadPath": "target",
        "maxAgeMs": 15000,
        "epsilon": 0.001
      },
      "payload": {
        "type": "object",
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "number",
            "minimum": 0,
            "maximum": 500
          }
        },
        "additionalProperties": false
      }
    }
  }
}
