{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelB",
  "type": "object",

  "commands": {
    "SET_LED": {
      "payload": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value": {
            "type": "boolean"
          }
        },
          "additionalProperties": false
      }
    },

    "SET_LED_COLOR": {
      "payload": {
        "type": "object",
        "required": ["color"],
        "properties": {
          "color": {
            "type": "string",
            "enum": [
              "RED",
              "GREEN",
              "BLUE",
              "YELLOW",
              "WHITE"
            ]
          }
        },
          "additionalProperties": false
      }
    },

    "SET_STATE": {
      "payload": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "IDLE"
            ]
          }
        },
          "additionalProperties": false
      }
    },
    "SET_MODE": {
      "payload": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value": {
            "type": "string",
            "enum": [
              "AUTO",
              "RUNNING",
              "SERVICE"
            ]
          }
        },
          "additionalProperties": false
      }
    }
  },

  "required": ["status"],

  "properties": {
    "schemaId": {
      "type": "string",
      "const": "modelB",
      "x-reporting": {
            "ACTIVE": 6000,
            "IDLE": 120000
        }
    },

    "data": {
      "type": "object",
    
      "properties": {
        "temp": {
          "type": "number",
          "minimum": -50,
          "maximum": 100,
          "x-reporting": {
            "ACTIVE": 6000,
            "IDLE": null
          }
        },
        "hum": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "x-reporting": {
            "ACTIVE": 3000,
            "IDLE": null
          }
        },
        "press": {
          "type": "number",
          "minimum": 300,
          "maximum": 1200,
             "x-reporting": {
            "ACTIVE": 6000,
            "IDLE": null
          }
          
        }
      },
      "additionalProperties": false
    },

    "status": {
      "type": "object",
      "required": ["ledState", "ledColor"],
      "properties": {
        "ledState": {
          "type": "boolean",
           "x-reporting": {
            "ACTIVE": 6000,
            "IDLE": 120000
          }
        },
        "ledColor": {
          "type": "string",
          "enum": [
            "RED",
            "GREEN",
            "BLUE",
            "YELLOW",
            "WHITE"
          ],
        "x-reporting": {
                "ACTIVE": 6000,
                "IDLE": 120000
          }
        }
      },
      "additionalProperties": false
    },
     "historicalTelemetry": {
      "type": "object",
      "properties": {
        "temp": {
          "type": "array",
          "maxItems": 24,

          "items": {
            "type": "array",

            "prefixItems": [
              {
                "type": "number",
                "minimum": -50,
                "maximum": 100
              },
              {
                "type": "string"
              }
            ],

            "items": false,
            "minItems": 2,
            "maxItems": 2
          },

          "x-buffering": {
            "interval": 5000
          }
        },
        "hum": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": 0, "maximum": 100 },
            { "type": "string" }
          ],
          "items": false,
            "minItems": 2,
            "maxItems": 2
        },
          "x-buffering": { "interval": 10000 }
        },
        "press": {
          "type": "array",
          "maxItems": 24,
          "items": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": 300, "maximum": 1200 },
            { "type": "string" }
          ],
          "items": false,
           "minItems": 2,
            "maxItems": 2
        },
          "x-buffering": { "interval": 5000 }
        }
      },
      "required": ["temp", "hum", "press"],
      "additionalProperties": false,
      "x-reporting": {
        "ACTIVE": null,
        "IDLE": 120000
      }
    }
  },
  "additionalProperties": false
}