{
  "type": "object",
  "title": "IndustrialAirCompressorTelemetry",
  "commands": {
    "SET_STATE": {
      "payload": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "enum": [
              "ACTIVE",
              "IDLE"
            ],
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "SET_GRID_SWITCH": {
      "payload": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "enum": [
              "ON",
              "OFF"
            ],
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "SET_BATTERY_MODE": {
      "payload": {
        "type": "object",
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "enum": [
              "CHARGING",
              "DISCHARGING",
              "STAGNANT"
            ],
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "SET_OPERATIONAL_MODE": {
      "payload": {
        "type": "object",
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "enum": [
              "OFF",
              "STANDBY",
              "GRID_TIED",
              "OFF_GRID",
              "FAULT_ISOLATION"
            ],
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "SET_TARGET_PRESSURE": {
      "payload": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "number",
            "minimum": 2,
            "maximum": 16
          }
        },
        "additionalProperties": false
      },
      "x-state-path": "performance.stages.p2",
      "x-payload-field": "value",
      "x-idempotency": {
        "stateBinding": "pressStage2",
        "payloadPath": "value",
        "maxAgeMs": 15000,
        "epsilon": 0.001
      }
    },
    "SET_OPERATING_PROFILE": {
      "payload": {
        "type": "object",
        "required": [
          "mode",
          "pressure",
          "safety",
          "schedule"
        ],
        "properties": {
          "mode": {
            "enum": [
              "ECONOMY",
              "NORMAL",
              "BOOST"
            ],
            "type": "string"
          },
          "safety": {
            "type": "object",
            "required": [
              "maxTemperature",
              "maxVibration"
            ],
            "properties": {
              "maxVibration": {
                "type": "number",
                "maximum": 25,
                "minimum": 0
              },
              "maxTemperature": {
                "type": "number",
                "maximum": 120,
                "minimum": 40
              }
            },
            "additionalProperties": false
          },
          "pressure": {
            "type": "object",
            "required": [
              "target"
            ],
            "properties": {
              "target": {
                "type": "number",
                "maximum": 16,
                "minimum": 2
              }
            },
            "additionalProperties": false
          },
          "schedule": {
            "type": "object",
            "required": [
              "durationMinutes"
            ],
            "properties": {
              "durationMinutes": {
                "type": "integer",
                "maximum": 1440,
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaId"
  ],
  "properties": {
    "system": {
      "type": "object",
      "properties": {
        "status": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "LOADED",
                "UNLOADED",
                "STANDBY",
                "FAULT"
              ],
              "type": "string",
              "x-reporting": {
                "IDLE": 120000,
                "ACTIVE": 6000
              }
            },
            "uptime_seconds": {
              "type": "integer",
              "minimum": 0,
              "x-reporting": {
                "IDLE": null,
                "ACTIVE": 6000
              }
            },
            "operatingProfile": {
              "enum": [
                "ECONOMY",
                "NORMAL",
                "BOOST"
              ],
              "type": "string",
              "x-reporting": {
                "IDLE": null,
                "ACTIVE": 6000
              }
            }
          }
        },
        "identity": {
          "type": "object",
          "properties": {
            "serial": {
              "type": "string",
              "pattern": "^CP-[0-9]{5}-X$",
              "x-reporting": {
                "IDLE": 120000,
                "ACTIVE": 6000
              }
            },
            "firmware": {
              "type": "string",
              "x-reporting": {
                "IDLE": 120000,
                "ACTIVE": 6000
              }
            }
          }
        }
      }
    },
    "schemaId": {
      "type": "string",
      "const": "modelB",
      "x-reporting": {
        "IDLE": 120000,
        "ACTIVE": 6000
      }
    },
