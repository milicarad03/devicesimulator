{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelB Telemetry Schema",
  "type": "object",
  "required": ["data", "status"],
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "modelB",
      "x-reporting": {
        "ACTIVE": 6000,
        "IDLE": 120000
      }

    },

    "data": {
      "type": "object",
      "required": ["temp", "hum", "press"],
      "properties": {
        "temp": {
          "type": "number",
          "minimum": -50,
          "maximum": 100,
          "x-reporting": {
            "ACTIVE": 3000,
            "IDLE": null
          }
        },
        "hum": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "x-reporting": {
            "ACTIVE": 3000,
            "IDLE": null
          }
        },
        "press": {
          "type": "number",
          "minimum": 300,
          "maximum": 1200,
           "x-reporting": {
            "ACTIVE": 6000,
            "IDLE": null
          }
        }
      },
      "additionalProperties": false
    },

    "status": {
      "type": "object",
      "required": ["ledState", "ledColor"],
      "properties": {
        "ledState": {
          "type": "boolean",
          "x-reporting": {
            "ACTIVE": 6000,
            "IDLE": 120000
          }
        },

        "ledColor": {
              "type": "string",
              "enum": [
                "RED",
                "GREEN",
                "BLUE",
                "YELLOW",
                "WHITE"
              ],
              "x-reporting": {
                "ACTIVE": 6000,
                "IDLE": 120000
              }
          }

      },
      "additionalProperties": false
    }
  },

  "additionalProperties": false
}