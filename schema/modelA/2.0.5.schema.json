{
  "type": "object",
  "title": "DeviceDashboard Telemetry Schema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "commands": {
    "SET_LED": {
      "payload": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "x-state-path": "telemetry.led",
      "x-payload-field": "value"
    },
    "SET_STATE": {
      "payload": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "enum": [
              "ACTIVE",
              "IDLE"
            ],
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaId"
  ],
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "modelA",
      "x-reporting": {
        "IDLE": 120000,
        "ACTIVE": 6000
      }
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "led": {
          "type": "boolean",
          "x-reporting": {
            "IDLE": 120000,
            "ACTIVE": 7000
          }
        },
        "humidity": {
          "type": "number",
          "maximum": 100,
          "minimum": 0,
          "x-reporting": {
            "IDLE": null,
            "ACTIVE": 10000
          }
        },
        "pressure": {
          "type": "number",
          "maximum": 1200,
          "minimum": 300,
          "x-reporting": {
            "IDLE": null,
            "ACTIVE": 6000
          }
        },
        "temperature": {
          "type": "number",
          "maximum": 100,
          "minimum": -50,
          "x-reporting": {
            "IDLE": null,
            "ACTIVE": 6000
          }
        }
      },
      "additionalProperties": false
    },
    "historicalTelemetry": {
      "type": "object",
      "required": [
        "temperature",
        "humidity",
        "pressure"
      ],
      "properties": {
        "humidity": {
          "type": "array",
          "items": {
            "type": "array",
            "items": false,
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number",
                "maximum": 100,
                "minimum": 0
              },
              {
                "type": "string"
              }
            ]
          },
          "maxItems": 24,
          "x-buffering": {
            "interval": 17000
          }
        },
        "pressure": {
          "type": "array",
          "items": {
            "type": "array",
            "items": false,
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number",
                "maximum": 1200,
                "minimum": 300
              },
              {
                "type": "string"
              }
            ]
          },
          "maxItems": 24,
          "x-buffering": {
            "interval": 10000
          }
        },
        "temperature": {
          "type": "array",
          "items": {
            "type": "array",
            "items": false,
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number",
                "maximum": 100,
                "minimum": -50
              },
              {
                "type": "string"
              }
            ]
          },
          "maxItems": 24,
          "x-buffering": {
            "interval": 15000
          }
        }
      },
      "x-reporting": {
        "IDLE": 120000,
        "ACTIVE": null
      },
      "additionalProperties": false
    }
  },
  "description": "Šema za validaciju dolaznih poruka sa simulatora Model A",
  "additionalProperties": false
}