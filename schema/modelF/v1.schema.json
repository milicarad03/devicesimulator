{
  "title": "IndustrialAirCompressorTelemetry",
  "type": "object",
 
  "properties": {
     "schemaId": { 
      "type": "string",
      "const": "modelF",
      "x-reporting": {
          "ACTIVE": 5000,
          "IDLE": 120000
        }
    },
    "system": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "object",
          "properties": {
            "serial": { "type": "string", "pattern": "^CP-[0-9]{5}-X$" ,   
            "x-reporting": {
              "ACTIVE": 5000,
              "IDLE": 120000
            }},
            
            "firmware": { "type": "string",
             "x-reporting": {
              "ACTIVE": 5000,
              "IDLE": 120000
            }}
          }
        },
        "status": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["LOADED", "UNLOADED", "STANDBY", "FAULT"],
             "x-reporting": {
              "ACTIVE": 4000,
              "IDLE": 120000
            } },
            "uptime_seconds": { "type": "integer", "minimum": 0,
             "x-reporting": {
              "ACTIVE": 5000,
              "IDLE": null
            }}
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "faults": {
          "type": "object",
          "properties": {
            "code": { "type": "string", "pattern": "^ERR-[0-9]{3}$" ,   
            "x-reporting": {
              "ACTIVE": 5000,
              "IDLE": 120000
            }},
            "alarms": { "type": "array", "maxItems": 5, "items": { "type": "string" },
             "x-reporting": {
              "ACTIVE": 5000,
              "IDLE": 120000
            }}
          }
        },
        "health": {
          "type": "object",
          "properties": {
            "oil_level": { "type": "number", "minimum": 0, "maximum": 100,
             "x-reporting": {
              "ACTIVE": 5000,
              "IDLE": 120000
            }},
            "vibration": { "type": "number", "minimum": 0, "maximum": 25.0,
             "x-reporting": {
              "ACTIVE": 5000,
              "IDLE": 120000
            }}
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "properties": {
        "stages": {
          "type": "object",
          "properties": {
            "p1": { "type": "number", "minimum": 0, "maximum": 8.0,
             "x-reporting": {
              "ACTIVE": 3000,
              "IDLE": null
            }},
            "p2": { "type": "number", "minimum": 0, "maximum": 16.0,
             "x-reporting": {
              "ACTIVE": 3000,
              "IDLE": null
            }},
            "tempIn": { "type": "number", "minimum": 10, "maximum": 50,
             "x-reporting": {
              "ACTIVE": 5000,
              "IDLE": null
            }},
            "tempOut": { "type": "number", "minimum": 40, "maximum": 120,
            "x-reporting": {
                "ACTIVE": 5000,
                "IDLE": null
              }}
          }
        },
        "electrical": {
          "type": "object",
          "properties": {
            "load": { "type": "number", "minimum": 0, "maximum": 100,
            "x-reporting": {
              "ACTIVE": 5000,
              "IDLE": null
            }},
            
            "kw": { "type": "number", "minimum": 0, "maximum": 250,
            "x-reporting": {
                "ACTIVE": 5000,
                "IDLE": null
              }},
            "voltage": { "type": "number", "minimum": 380, "maximum": 440,
            "x-reporting": {
              "ACTIVE": 5000,
              "IDLE": null
            }},
            
            "pf": { "type": "number", "minimum": 0.7, "maximum": 1.0,
            "x-reporting": {
                "ACTIVE": 5000,
                "IDLE": null
              }}
            
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "flow": { "type": "number", "minimum": 0, "maximum": 50.0,
            "x-reporting": {
              "ACTIVE": 5000,
              "IDLE": null
            }},
            
            
            "total_runtime": { "type": "integer", "minimum": 0,
            "x-reporting": {
                "ACTIVE": 5000,
                "IDLE": null
              }},
            "energy_kwh": { "type": "number", "minimum": 0,
            "x-reporting": {
                "ACTIVE": 5000,
                "IDLE": null
              }}
          }
        }
      }
    }
  }
}