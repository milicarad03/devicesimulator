                "type": "string",
                "x-reporting": {
                  "IDLE": 120000,
                  "ACTIVE": 6000
                }
              },
              "uptime_seconds": {
                "type": "integer",
                "minimum": 0,
                "x-reporting": {
                  "IDLE": null,
                  "ACTIVE": 6000
                }
              },
              "operatingProfile": {
                "enum": [
                  "ECONOMY",
                  "NORMAL",
                  "BOOST"
                ],
                "type": "string",
                "x-reporting": {
                  "IDLE": null,
                  "ACTIVE": 6000
                }
              }
