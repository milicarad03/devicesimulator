{
  "model": "modelB",
  "version": "5.0.2",
  "schema": {
    "type": "object",
    "title": "IndustrialAirCompressorTelemetry",
    "commands": {
      "SET_STATE": {
        "payload": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "ACTIVE",
                "IDLE"
              ],
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "SET_GRID_SWITCH": {
        "payload": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "enum": [
                "ON",
                "OFF"
              ],
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "SET_BATTERY_MODE": {
        "payload": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "CHARGING",
                "DISCHARGING",
                "STAGNANT"
              ],
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "SET_TARGET_PRESSURE": {
        "payload": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "number",
              "maximum": 16,
              "minimum": 2
            }
          },
          "additionalProperties": false
        }
      },
      "SET_OPERATIONAL_MODE": {
        "payload": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "OFF",
                "STANDBY",
                "GRID_TIED",
                "OFF_GRID",
                "FAULT_ISOLATION"
              ],
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "SET_OPERATING_PROFILE": {
        "payload": {
          "type": "object",
          "required": [
            "mode",
            "pressure",
            "safety",
            "schedule"
          ],
          "properties": {
            "mode": {
              "enum": [
                "ECONOMY",
                "NORMAL",
                "BOOST"
              ],
              "type": "string"
            },
            "safety": {
              "type": "object",
              "required": [
                "maxTemperature",
                "maxVibration"
              ],
              "properties": {
                "maxVibration": {
                  "type": "number",
                  "maximum": 25,
                  "minimum": 0
                },
                "maxTemperature": {
                  "type": "number",
                  "maximum": 120,
                  "minimum": 40
                }
              }
            },
            "pressure": {
              "type": "object",
              "required": [
                "target"
              ],
              "properties": {
                "target": {
                  "type": "number",
                  "maximum": 16,
                  "minimum": 2
                }
              }
            },
            "schedule": {
              "type": "object",
              "required": [
                "durationMinutes"
              ],
              "properties": {
                "durationMinutes": {
                  "type": "integer",
                  "maximum": 1440,
                  "minimum": 1
                }
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "required": [
      "schemaId"
    ],
    "properties": {
      "system": {
        "type": "object",
        "properties": {
          "status": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": [
                  "LOADED",
                  "UNLOADED",
                  "STANDBY",
                  "FAULT"
